# Upstream provider
UPSTREAM_BASE_URL=https://agentrouter.org
UPSTREAM_API_KEY=replace-with-provider-key
UPSTREAM_USER_AGENT=claude-cli/1.0.83 (external, cli)

# Local proxy. Keep loopback-only to avoid touching/exposing other services.
HOST=127.0.0.1
PORT=33110

# The key Zoo Code sends to this local bridge.
# Leave empty to accept any key (not recommended outside localhost).
LOCAL_API_KEY=api

# Timeout for a single upstream attempt, in milliseconds.
REQUEST_TIMEOUT_MS=120000

# Fallback output limit when the client sends none. Zoo Code usually sends none,
# and the old hard-coded 4096 silently truncated long answers.
DEFAULT_MAX_TOKENS=32768
# Optional per-model ceilings, prefix match, e.g.
# MODEL_MAX_TOKENS=claude-opus-5=32768,glm-5.3=16384
MODEL_MAX_TOKENS=

# --- context compaction ----------------------------------------------------
# A single live request reached 6.17 MB, so a ceiling is not optional.
#   off     - never touch the conversation
#   trim    - drop whole middle turns, keep head and tail
#   summary - replace the middle span with a local digest of what happened
#   hybrid  - summary first, hard trim as the floor if still over budget
COMPACT_MODE=hybrid
# Estimated input tokens allowed before compaction engages (~4 chars/token).
COMPACT_MAX_TOKENS=180000
# Turns kept verbatim at each end: head carries the task, tail carries the work.
COMPACT_KEEP_HEAD=2
COMPACT_KEEP_TAIL=6

# --- disk hygiene ----------------------------------------------------------
# Four days without these produced 21.4 GB in diag/ and a 37 MB proxy.log.
LOG_MAX_BYTES=16777216
LOG_KEEP=3
DIAG_MAX_FILES=400
DIAG_MAX_BYTES=536870912
# One dump per distinct failure signature; repeats are counted in the log.
DIAG_DEDUPE=1
DIAG_MAX_BODY_BYTES=262144

# --- recovery ladder -------------------------------------------------------
# The gateway runs a content gate that rejects some requests deterministically
# (same bytes -> same rejection, every time). Retrying identical bytes never
# helps, so each step below changes something real about the request instead.
# All steps are on by default; set a value to 0 to disable one.

# Measured over 5906 live requests: every payload with block-form content plus a
# tool catalogue was refused on /v1/chat/completions and accepted on /v1/messages.
# With this on, such requests lead with the form that passes instead of walking
# two guaranteed failures first. The skipped rung is demoted, not removed.
SHAPE_ROUTING=1

# Step: append one neutral sentence to the last user message.
# At scale this rescued 16 of 5906 requests while costing 4688 rejections, so it
# now sits AFTER the anthropic form. Set to 0 to place it first again.
NUDGE_AFTER_ANTHROPIC=1
NUDGE_RETRY=1
NUDGE_TEXT=(Please respond to the message above.)

# Step: replay over /v1/messages with the system prompt hoisted to a top-level
# field. This is the request shape claude-cli uses.
ANTHROPIC_RETRY=1

# Step: collapse the whole conversation into a single labelled user message.
FLATTEN_RETRY=1

# Step: a second gateway host with its own key and quota. If left empty, the
# bridge falls back to ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN when those are
# present in the environment.
UPSTREAM_FALLBACK_BASE_URL=
UPSTREAM_FALLBACK_API_KEY=

# Step: swap the model. Off by default because it changes which model answers.
# Comma-separated, tried in order, e.g. glm-5.3,deepseek-v4-flash
MODEL_FALLBACKS=

# Retries for genuinely transient faults only (network errors, 429, non-filter 5xx).
MAX_RETRIES=2
RETRY_DELAY_MS=1000

# Write the full body of every rejected request to diag/ for later inspection.
DIAG_DUMPS=1

# Models whose upstream streaming is broken; requested non-stream and re-emitted
# as SSE. Matched by prefix, case-insensitive.
NO_STREAM_MODELS=claude,gpt
