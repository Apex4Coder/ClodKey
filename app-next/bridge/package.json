{
  "name": "agentrouter-openai-bridge",
  "version": "1.1.0",
  "private": true,
  "description": "Local OpenAI-compatible bridge for agentrouter.org",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check server.mjs",
    "test": "node --check server.mjs && node tools/unit-transforms.mjs",
    "test:unit": "node tools/unit-transforms.mjs",
    "test:e2e": "node tools/e2e-bridge.mjs",
    "test:soak": "node tools/soak-bridge.mjs",
    "test:shape": "node tools/verify-shape-routing.mjs",
    "analyze": "node tools/analyze-log.mjs",
    "prune": "node tools/prune-diag.mjs"
  }
}
