# ============================================================
# ClodKeyProxy - paths that must NEVER be committed
# ============================================================

# ---- runtime state (secrets, logs, backups) -----------------
# data\secrets.json is DPAPI ciphertext (CurrentUser only).
# logs\ and backups\ are local history. State lives OUTSIDE
# the release on purpose (updating the app moves code only).
data/
logs/
backups/

# ---- installed release + rollback snapshots -----------------
live/
live.prev-*/

# ---- bridge runtime: credentials + captured traffic --------
# .env holds the real UPSTREAM_API_KEY; diag/ holds full
# request bodies captured on rejection.
app-next/bridge/.env
app-next/bridge/*.log
app-next/bridge/*.log.*
app-next/bridge/diag/
app-next/bridge/.z.tmp.mjs
app-next/bridge/.z-run.mjs

# ---- node dependencies (bridge is dependency-free) ----------
node_modules/

# ---- app logs ----------------------------------------------
app-next/*.log

# ---- OS noise ----------------------------------------------
Thumbs.db
Desktop.ini

# ---- editors -----------------------------------------------
.vscode/
.idea/
*.swp

# ---- local drop folders (patches/archives, not the release) -
00/

# internal dev process (local only)
SPEC.md
deploy.ps1
deploy-next.bat
verify-deploy.ps1
tests/
